# 1. Load Required Libraries
library(compositions)
library(Maaslin2)
library(tidyverse)

# 2. Define File Paths and Variables
metadata_file <- "sm_metadata_treatments_diet_relative_body_mass.tsv"
feature_file  <- "featuretable_gg2.tsv"
output_dir    <- "maaslin2_FM3_results"

# Store your 4 specific features of interest exactly as they appear in data
target_features <- c(
  "RS.GCF.003671855.1.NZ.RAZM01000129.1",
  "RS.GCF.015235485.1.NZ.JADGLP010000315.1",
  "MJ006.2.barcode53.umi152854bins.ubs.3",
  "MJ006.1.barcode40.umi135191bins.ubs.4"
)

# 3. Load Data Matrices
metadata_raw <- read.delim(metadata_file, sep = "\t", header = TRUE, check.names = FALSE)
features_raw <- read.delim(feature_file, sep = "\t", header = TRUE, check.names = FALSE)

# 4. Clean and Format Structures
# Clean metadata: set sample names as row indices
metadata <- metadata_raw %>% 
  column_to_rownames("sample_name")

# Clean features: set Feature_ID as row indices, transpose so samples are rows
features_transposed <- features_raw %>% 
  column_to_rownames("Feature_ID") %>% 
  t() %>% 
  as.data.frame()

# Harmonize sample lists across both files
common_samples <- intersect(rownames(metadata), rownames(features_transposed))
metadata <- metadata[common_samples, , drop = FALSE]
features_transposed <- features_transposed[common_samples, ]

# 5. Set Factor Levels and Baseline Reference Group
metadata$Group <- as.factor(metadata$Group)
metadata$Group <- relevel(metadata$Group, ref = "FM3")

# 6. Apply Robust CLR (rCLR) Transformation Globally
# Operates on non-zero values per sample row; does not distort data structures
rclr_transformed <- as.data.frame(clr(features_transposed))

# 7. Run MaAsLin2 Pipeline on Complete Feature Matrix
# This ensures multiple-testing corrections account for the post-hoc screening
fit_data <- Maaslin2(
  input_data     = rclr_transformed, 
