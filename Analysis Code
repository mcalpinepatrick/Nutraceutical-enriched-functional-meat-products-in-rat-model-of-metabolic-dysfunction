  feature_filtered[, -1, drop = FALSE]
)

storage.mode(count_matrix) <- "numeric"

rownames(count_matrix) <- feature_filtered$Feature_ID

if (anyNA(count_matrix) || any(!is.finite(count_matrix))) {
  stop("Count matrix contains missing or non-finite values.")
}

if (any(count_matrix < 0)) {
  stop("Count matrix contains negative abundances.")
}

# Remove samples with zero total counts to avoid division by zero
sample_totals <- colSums(count_matrix)

zero_samples <- names(sample_totals)[sample_totals == 0]

if (length(zero_samples) > 0) {
  warning(
    "Removing samples with zero total counts: ",
    paste(zero_samples, collapse = ", ")
  )
  
  count_matrix <- count_matrix[
    , sample_totals > 0, drop = FALSE
  ]
  
  metadata_filtered <- metadata_filtered %>%
    filter(sample_name %in% colnames(count_matrix))
}

if (ncol(count_matrix) < 2) {
  stop("At least two non-zero samples are required for z-scoring.")
}

# ------------------------------------------------------------
# 7. Convert counts to relative abundances
# ------------------------------------------------------------

# Divide each ASV count by the total count in its sample.
relative_abundance <- sweep(
  count_matrix,
  MARGIN = 2,
  STATS = colSums(count_matrix),
  FUN = "/"
)

# ------------------------------------------------------------
# 8. Calculate z-scores for each ASV across samples
# ------------------------------------------------------------

# Each ASV is standardized across all retained samples.
# Rows = ASVs; columns = samples.

asv_means <- rowMeans(relative_abundance)

asv_sds <- apply(relative_abundance, 1, sd)

# Remove ASVs with zero variance, since their z-scores are undefined.
variable_asvs <- !is.na(asv_sds) & asv_sds > 0

relative_abundance_variable <- relative_abundance[
  variable_asvs, , drop = FALSE
]

asv_means_variable <- asv_means[variable_asvs]
asv_sds_variable <- asv_sds[variable_asvs]

zscore_matrix <- sweep(
  relative_abundance_variable,
  MARGIN = 1,
  STATS = asv_means_variable,
  FUN = "-"
)

zscore_matrix <- sweep(
  zscore_matrix,
  MARGIN = 1,
  STATS = asv_sds_variable,
  FUN = "/"
)

# ------------------------------------------------------------
# 9. Keep only the requested ASVs
# ------------------------------------------------------------

asvs_found <- intersect(
  selected_asvs,
  rownames(zscore_matrix)
)

asvs_missing <- setdiff(
  selected_asvs,
  rownames(count_matrix)
)

asvs_zero_variance <- intersect(
  selected_asvs,
  rownames(count_matrix)[!variable_asvs]
)

if (length(asvs_missing) > 0) {
  warning(
    "These requested ASVs were not found in the feature table: ",
    paste(asvs_missing, collapse = ", ")
  )
}

if (length(asvs_zero_variance) > 0) {
  warning(
    "These requested ASVs have zero variance and cannot be z-scored: ",
    paste(asvs_zero_variance, collapse = ", ")
  )
}

if (length(asvs_found) == 0) {
  stop(
    "None of the selected ASVs were available for heatmap generation."
  )
}

zscore_selected <- zscore_matrix[
  asvs_found, , drop = FALSE
]

# ------------------------------------------------------------
# 10. Calculate mean z-score for each ASV in each group
# ------------------------------------------------------------

sample_groups <- metadata_filtered$Group[
  match(colnames(zscore_selected),
        metadata_filtered$sample_name)
]

mean_zscore_by_group <- sapply(
  groups_to_keep,
  function(g) {
    group_samples <- colnames(zscore_selected)[
      sample_groups == g
    ]
    
    if (length(group_samples) == 0) {
      return(rep(NA_real_, nrow(zscore_selected)))
    }
    
    rowMeans(
      zscore_selected[, group_samples, drop = FALSE]
    )
  }
)

rownames(mean_zscore_by_group) <- rownames(zscore_selected)

# Remove groups with no retained samples
groups_present <- groups_to_keep[
  groups_to_keep %in% as.character(sample_groups)
]

mean_zscore_by_group <- mean_zscore_by_group[
  , groups_present, drop = FALSE
]

# ------------------------------------------------------------
# 11. Save the mean z-score matrix
# ------------------------------------------------------------

write.table(
  mean_zscore_by_group,
  file = file.path(
    output_dir,
    "mean_zscore_relative_abundance_by_group.tsv"
  ),
  sep = "\t",
  quote = FALSE,
  col.names = NA
)

# Save the retained sample metadata
write.table(
  metadata_filtered,
  file = file.path(output_dir, "filtered_metadata.tsv"),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

# ------------------------------------------------------------
# 12. Generate the heatmap
# ------------------------------------------------------------

# Do not cluster groups or ASVs, so the requested group order
# and ASV order are preserved.

heatmap_colors <- colorRampPalette(
  c("#2166AC", "white", "#B2182B")
)(100)

# Symmetric color limits centered on zero
max_abs <- max(abs(mean_zscore_by_group), na.rm = TRUE)

if (!is.finite(max_abs) || max_abs == 0) {
  max_abs <- 1
}
pheatmap(
  mean_zscore_by_group,
  color = heatmap_colors,
  breaks = seq(-max_abs, max_abs, length.out = 101),
  cluster_rows = FALSE,
  cluster_cols = FALSE,
  scale = "none",
  border_color = "grey85",
  na_col = "grey75",
  fontsize = 10,
  fontsize_row = 8,
  fontsize_col = 11,
  angle_col = 45,
  main = "Mean z-scored relative abundance by group",
  xlab = "Experimental group",
  ylab = "ASV",
  legend = TRUE,
  filename = NA
)

