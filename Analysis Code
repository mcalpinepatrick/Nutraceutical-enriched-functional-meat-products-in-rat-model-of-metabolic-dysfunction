####calculate beta group significance for all samples, including obese controls
############################################################
# ROBUST AITCHISON BETA-DIVERSITY ANALYSIS
#
# RStudio script
#
# Input:
#   sm_metadata_all_groups.tsv
#   featuretable_gg2.tsv
#
# Output:
#   permdisp_results.csv
#   pairwise_robust_aitchison_permanova_results.csv
#
# Workflow:
#
#   1. Robust Aitchison distance using vegan
#   2. Global PERMDISP
#   3. Pairwise PERMANOVA using adonis2
#   4. Benjamini-Hochberg FDR correction
#
# IMPORTANT:
# PERMANOVA is performed regardless of the PERMDISP result.
# If PERMDISP is significant, this is reported in the output
# as an important qualification of the PERMANOVA results.
#
############################################################


# ============================================================
# 1. SETTINGS
# ============================================================

metadata_file <- "sm_metadata_all_groups.tsv"

featuretable_file <- "featuretable_gg2.tsv"

permdisp_output <- "permdisp_results.csv"

permanova_output <-
  "pairwise_robust_aitchison_permanova_results.csv"

# Number of permutations
n_permutations <- 9999

# Significance threshold
alpha <- 0.05

# Reproducibility
random_seed <- 12345


# ============================================================
# 2. LOAD VEGAN
# ============================================================

if (!requireNamespace("vegan", quietly = TRUE)) {
  install.packages("vegan")
}

library(vegan)


# ============================================================
# 3. READ INPUT FILES
# ============================================================

cat("\nReading input files...\n")

metadata <- read.delim(
  metadata_file,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE
)

featuretable <- read.delim(
  featuretable_file,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE
)


# ============================================================
# 4. CHECK REQUIRED COLUMNS
# ============================================================

if (!"sample_name" %in% colnames(metadata)) {
  stop(
    "ERROR: 'sample_name' column was not found in metadata."
  )
}

if (!"Group" %in% colnames(metadata)) {
  stop(
    "ERROR: 'Group' column was not found in metadata."
  )
}

if (!"Feature_ID" %in% colnames(featuretable)) {
  stop(
    "ERROR: 'Feature_ID' column was not found in feature table."
  )
  
  
}


# ============================================================
# 5. CHECK FOR DUPLICATE IDENTIFIERS
# ============================================================

if (anyDuplicated(metadata$sample_name)) {
  stop(
    "ERROR: Duplicate sample_name values were found."
  )
}

if (anyDuplicated(featuretable$Feature_ID)) {
  stop(
    "ERROR: Duplicate Feature_ID values were found."
  )
}


# ============================================================
# 6. FIND SHARED SAMPLES
# ============================================================

metadata_samples <- metadata$sample_name

featuretable_samples <- colnames(featuretable)[
  colnames(featuretable) != "Feature_ID"
]

shared_samples <- intersect(
  metadata_samples,
  featuretable_samples
)

cat(
  "\nSamples in metadata:",
  length(metadata_samples),
  "\n"
)

cat(
  "Samples in feature table:",
  length(featuretable_samples),
  "\n"
)

cat(
  "Shared samples:",
  length(shared_samples),
  "\n"
)

if (length(shared_samples) < 2) {
  stop(
    "ERROR: Fewer than two shared samples were found."
  )
}


# ============================================================
# 7. RESTRICT DATA TO SHARED SAMPLES
# ============================================================

metadata <- metadata[
  match(
    shared_samples,
    metadata$sample_name
  ),
  ,
  drop = FALSE
]

featuretable <- featuretable[
  ,
  c(
    "Feature_ID",
    shared_samples
  ),
  drop = FALSE
]

rownames(metadata) <- metadata$sample_name


# ============================================================
# 8. CONVERT FEATURE TABLE TO NUMERIC
# ============================================================

cat("\nPreparing feature table...\n")

feature_matrix <- as.matrix(
  featuretable[
    ,
    shared_samples,
    drop = FALSE
  ]
)

suppressWarnings(
  mode(feature_matrix) <- "numeric"
)

if (anyNA(feature_matrix)) {
  stop(
    "ERROR: NA values were detected in the feature table."
  )
}

if (any(feature_matrix < 0)) {
  stop(
    "ERROR: Negative abundance values were detected."
  )
}


# ============================================================
# 9. REMOVE FEATURES ABSENT FROM ALL SAMPLES
# ============================================================

keep_features <- rowSums(
  feature_matrix
) > 0

feature_matrix <- feature_matrix[
  keep_features,
  ,
  drop = FALSE
]

cat(
  "Features retained:",
  nrow(feature_matrix),
  "\n"
)


# ============================================================
# 10. TRANSPOSE TO SAMPLE × FEATURE
# ============================================================

otu <- t(feature_matrix)

rownames(otu) <- shared_samples


# ============================================================
# 11. CHECK FOR ZERO-ABUNDANCE SAMPLES
# ============================================================

sample_totals <- rowSums(otu)

if (any(sample_totals == 0)) {
  
  zero_samples <- names(
    sample_totals[
      sample_totals == 0
    ]
  )
  
  stop(
    "ERROR: Samples with zero total abundance:\n",
    paste(
      zero_samples,
      collapse = ", "
    )
  )
}


# ============================================================
# 12. PREPARE GROUP VARIABLE
# ============================================================

metadata$Group <- factor(
  metadata$Group
)

if (nlevels(metadata$Group) < 2) {
  stop(
    "ERROR: At least two groups are required."
  )
}

cat("\nGroup sizes:\n")

print(
  table(metadata$Group)
)


# ============================================================
# 13. VERIFY SAMPLE ORDER
# ============================================================

metadata <- metadata[
  match(
    rownames(otu),
    metadata$sample_name
  ),
  ,
  drop = FALSE
]

if (!all(
  rownames(otu) ==
  metadata$sample_name
)) {
  
  stop(
    "ERROR: Sample order does not match between ",
    "feature table and metadata."
  )
}


# ============================================================
# 14. ROBUST AITCHISON DISTANCE
# ============================================================

cat("\n")
cat("============================================\n")
cat("ROBUST AITCHISON DISTANCE\n")
cat("============================================\n")

cat(
  "Calculating robust Aitchison distances...\n"
)

robust_aitchison <- vegdist(
  otu,
  method = "robust.aitchison"
)

cat(
  "Robust Aitchison calculation complete.\n"
)


# ============================================================
# 15. GLOBAL PERMDISP
# ============================================================

cat("\n")
cat("============================================\n")
cat("GLOBAL PERMDISP\n")
cat("============================================\n")

dispersion <- betadisper(
  robust_aitchison,
  metadata$Group,
  type = "centroid"
)

set.seed(random_seed)

permdisp_test <- permutest(
  dispersion,
  permutations = n_permutations
)

print(
  permdisp_test
)


# ============================================================
# 16. EXTRACT PERMDISP RESULTS
# ============================================================

permdisp_F <- permdisp_test$tab[
  1,
  "F"
]

permdisp_p <- permdisp_test$tab[
  1,
  "Pr(>F)"
]

permdisp_significant <- (
  permdisp_p < alpha
)


permdisp_results <- data.frame(
  
  Test = "Global PERMDISP",
  
  F_statistic = permdisp_F,
  
  P_value = permdisp_p,
  
  Significant = ifelse(
    permdisp_significant,
    "Yes",
    "No"
  ),
  
  permutations = n_permutations
  
)


write.csv(
  permdisp_results,
  permdisp_output,
  row.names = FALSE
)


# ============================================================
# 17. REPORT PERMDISP
# ============================================================

cat("\n")
cat("============================================\n")
cat("PERMDISP SUMMARY\n")
cat("============================================\n")

cat(
  "PERMDISP F =",
  permdisp_F,
  "\n"
)

cat(
  "PERMDISP P =",
  permdisp_p,
  "\n"
)

if (permdisp_significant) {
  
  cat(
    "\nPERMDISP is SIGNIFICANT.\n"
  )
  
  cat(
    "Group dispersions differ significantly.\n"
  )
  
  cat(
    "PERMANOVA will nevertheless be performed,\n"
  )
  
  cat(
    "but the PERMANOVA results should be interpreted\n"
  )
  
  cat(
    "with this dispersion effect in mind.\n"
  )
  
} else {
  
  cat(
    "\nPERMDISP is NOT significant.\n"
  )
  
  cat(
    "There is no evidence of significant differences\n"
  )
  
  cat(
    "in multivariate dispersion among groups.\n"
  )
  
}

cat(
  "\nPERMDISP results saved to:",
  permdisp_output,
  "\n"
)


# ============================================================
# 18. PAIRWISE PERMANOVA
# ============================================================
#
# IMPORTANT:
#
# PERMANOVA is performed regardless of whether PERMDISP
# is significant.
#
# ============================================================

cat("\n")
cat("============================================\n")
cat("PAIRWISE PERMANOVA\n")
cat("============================================\n")

groups <- levels(
  metadata$Group
)

pairwise_results <- list()

counter <- 1


for (i in seq_len(
  length(groups) - 1
)) {
  
  for (j in (i + 1):length(groups)) {
    
    group1 <- groups[i]
    
    group2 <- groups[j]
    
    
    cat("\n")
    cat("--------------------------------------------\n")
    
    cat(
      "Testing:",
      group1,
      "vs",
      group2,
      "\n"
    )
    
    cat("--------------------------------------------\n")
    
    
    # --------------------------------------------------------
    # Select the two groups
    # --------------------------------------------------------
    
    keep <- metadata$Group %in% c(
      group1,
      group2
    )
    
    sub_metadata <- metadata[
      keep,
      ,
      drop = FALSE
    ]
    
    sample_names <- sub_metadata$sample_name
    
    
    # --------------------------------------------------------
    # Subset robust Aitchison distances
    # --------------------------------------------------------
    
    distance_matrix <- as.matrix(
      robust_aitchison
    )
    
    sub_distance_matrix <- distance_matrix[
      sample_names,
      sample_names,
      drop = FALSE
    ]
    
    sub_distance <- as.dist(
      sub_distance_matrix
    )
    
    
    # --------------------------------------------------------
    # PERMANOVA
    # --------------------------------------------------------
    
    set.seed(
      random_seed
    )
    
    adonis_result <- adonis2(
      sub_distance ~ Group,
      data = sub_metadata,
      permutations = n_permutations,
      by = "terms"
    )
    
    
    # --------------------------------------------------------
    # Extract statistics
    # --------------------------------------------------------
    
    pseudo_F <- adonis_result$F[1]
    
    r2 <- adonis_result$R2[1]
    
    p_value <- adonis_result$`Pr(>F)`[1]
    
    
    # --------------------------------------------------------
    # Save result
    # --------------------------------------------------------
    
    pairwise_results[[counter]] <- data.frame(
      
      Group1 = group1,
      
      Group2 = group2,
      
      N_Group1 = sum(
        sub_metadata$Group ==
          group1
      ),
      
      N_Group2 = sum(
        sub_metadata$Group ==
          group2
      ),
      
      Pseudo_F = pseudo_F,
      
      R2 = r2,
      
      P_value = p_value,
      
      stringsAsFactors = FALSE
      
    )
    
    
    cat(
      "Pseudo-F:",
      pseudo_F,
      "\n"
    )
    
    cat(
      "R2:",
      r2,
      "\n"
    )
    
    cat(
      "P-value:",
      p_value,
      "\n"
    )
    
    
    counter <- counter + 1
    
  }
}


# ============================================================
# 19. COMBINE PAIRWISE RESULTS
# ============================================================

pairwise_results <- do.call(
  rbind,
  pairwise_results
)


# ============================================================
# 20. FDR CORRECTION
# ============================================================
#
# Benjamini-Hochberg correction is applied across ALL
# pairwise PERMANOVA comparisons.
#
# ============================================================

pairwise_results$Q_value <- p.adjust(
  pairwise_results$P_value,
  method = "BH"
)


# ============================================================
# 21. ADD SIGNIFICANCE
# ============================================================

pairwise_results$Significant_FDR <-
  ifelse(
    pairwise_results$Q_value < alpha,
    "Yes",
    "No"
  )


# ============================================================
# 22. ADD PERMDISP INFORMATION
# ============================================================

pairwise_results$Global_PERMDISP_P <-
  permdisp_p

pairwise_results$Global_PERMDISP_Significant <-
  ifelse(
    permdisp_significant,
    "Yes",
    "No"
  )


# ============================================================
# 23. ORDER RESULTS
# ============================================================

pairwise_results <- pairwise_results[
  order(
    pairwise_results$Q_value,
    pairwise_results$P_value
  ),
]


# ============================================================
# 24. EXPORT RESULTS
# ============================================================

write.csv(
  pairwise_results,
  permanova_output,
  row.names = FALSE
)


# ============================================================
# 25. PRINT FINAL RESULTS
# ============================================================

cat("\n")
cat("============================================\n")
cat("PAIRWISE PERMANOVA RESULTS\n")
cat("============================================\n\n")

print(
  pairwise_results
)


