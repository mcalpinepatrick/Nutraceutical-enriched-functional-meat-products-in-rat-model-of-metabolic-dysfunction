###test association between metadata and Aitchison PCoA by Adonis test
###use strata to ensure permutation ins within group, to account for group structure
# 1. Load required libraries
library(tidyverse)
library(vegan)

# 2. Load and align the input datasets
feature_table <- read_tsv("featuretable_gg2.tsv") %>%
  column_to_rownames("Feature_ID") %>%
  t() %>%
  as.data.frame()

metadata_table <- read_tsv("sm_metadata_treatments_diet_relative_body_mass.tsv") %>%
  column_to_rownames("sample_name")

# Match rows across files exactly
common_samples <- intersect(rownames(feature_table), rownames(metadata_table))
feature_table <- feature_table[common_samples, ]
metadata_table <- metadata_table[common_samples, ]

# Calculate master robust Aitchison distance matrix
sample_dist <- vegdist(feature_table, method = "robust.aitchison")

# Initialize results data frame
permanova_blocked_results <- data.frame(
  Variable = character(),
  Type = character(),
  R2 = numeric(),
  F_Statistic = numeric(),
  p_value = numeric(),
  stringsAsFactors = FALSE
)

# 3. Run the loop, setting Group as a random effect/strata block
for (col_name in colnames(metadata_table)) {
  
  # CRITICAL EXCLUSION: Skip the 'Group' column itself, since you cannot 
  # block by Group while testing the effect of Group.
  if (col_name == "Group") next
  
  var_vector <- metadata_table[[col_name]]
  
  # Skip columns that are completely empty or have zero total variance
  if (all(is.na(var_vector)) || length(unique(na.omit(var_vector))) < 2) next
  
  # Filter out sample rows containing NA for this specific column
  valid_samples <- !is.na(var_vector)
  sub_dist <- as.dist(as.matrix(sample_dist)[valid_samples, valid_samples])
  sub_var <- var_vector[valid_samples]
  
  # Extract the group assignments matching only the valid samples
  sub_group_block <- as.factor(metadata_table$Group[valid_samples])
  
  # CRITICAL SKIP: If a variable is perfectly constant within ALL groups, 
  # shuffling inside the groups yields zero variation. Adonis2 will crash.
  # We track if the variable changes at least slightly inside the blocks.
  if (is.numeric(sub_var)) {
    # Check if there's any variance left within groups
    within_group_sd <- aggregate(sub_var ~ sub_group_block, FUN = sd)
    if (all(within_group_sd$sub_var == 0, na.rm = TRUE)) {
      cat(paste("Skipping", col_name, "- perfectly constant within groups.\n"))
      next
    }
  }
  
  # Run PERMANOVA with Group as a random blocking effect
  # strata = sub_group_block locks the permutation engine inside each group
  res <- adonis2(sub_dist ~ sub_var, strata = sub_group_block, permutations = 999)
  
  var_type <- if(is.numeric(sub_var)) "Continuous" else "Categorical"
  
  permanova_blocked_results <- permanova_blocked_results %>% 
    add_row(
      Variable = col_name,
      Type = var_type,
      R2 = res$R2[1],
      F_Statistic = res$F[1],
      p_value = res$`Pr(>F)`[1]
    )
}

# 4. Apply False Discovery Rate (FDR) correction and display
permanova_blocked_results <- permanova_blocked_results %>%
  mutate(q_value = p.adjust(p_value, method = "fdr")) %>%
  arrange(desc(R2))

print("Indivudal Variable PERMANOVA Results (Group-Blocked Mixed Design):")
print(permanova_blocked_results)

# Save results
write_csv(permanova_blocked_results, "group_blocked_permanova_results.csv")

