# ============================================================
# MaAsLin2 sample-level analysis
#
# Predictors:
#   1. Cecum_mass/Body_mass
#   2. Leptin
#   3. Visceral_Fat_mass/Body_mass
#   4. HDL_cholesterol
#
# Workflow:
#   Raw ASV counts
#       ↓
#   TSS normalization
#       ↓
#   Prevalence filter: ASV present in >= 7 samples
#       ↓
#   Pseudocount + log2 transformation
#       ↓
#   Sample-level ASV data
#       ↓
#   MaAsLin2, one predictor at a time
#       ↓
#   Group included as a random effect
#       ↓
#   Collect significant ASVs
#       ↓
#   Heatmap of MaAsLin2 coefficients
# ============================================================


# ============================================================
# 1. Load packages
# ============================================================

library(tidyverse)
library(pheatmap)
library(Maaslin2)


# ============================================================
# 2. Read data
# ============================================================

metadata <- read_tsv(
  "sm_metadata_treatments_diet_relative_body_mass.tsv",
  show_col_types = FALSE
)

feature_table <- read_tsv(
  "featuretable_gg2.tsv",
  show_col_types = FALSE
)


# ============================================================
# 3. Convert feature table to ASV matrix
# ============================================================

asv_matrix <- feature_table %>%
  column_to_rownames("Feature_ID") %>%
  as.matrix()


# ============================================================
# 4. Keep only samples present in BOTH datasets
# ============================================================

common_samples <- intersect(
  metadata$sample_name,
  colnames(asv_matrix)
)

metadata <- metadata %>%
  filter(sample_name %in% common_samples)

asv_matrix <- asv_matrix[, metadata$sample_name]


# Check dimensions
cat("Number of samples:", ncol(asv_matrix), "\n")
cat("Number of ASVs:", nrow(asv_matrix), "\n")


# ============================================================
# 5. TSS normalization
# ============================================================

tss_matrix <- apply(
  asv_matrix,
  2,
  function(x) x / sum(x)
)


# ============================================================
# 6. Prevalence filtering
#
# Retain ASVs present in >= 7 samples.
#
# "Present" = abundance > 0 in the original count table.
# ============================================================

prevalence_counts <- rowSums(asv_matrix > 0)

prevalence_table <- tibble(
  Feature_ID = rownames(asv_matrix),
  prevalence = prevalence_counts,
  prevalence_proportion =
    prevalence_counts / ncol(asv_matrix),
  retained = prevalence_counts >= 7
)

write_tsv(
  prevalence_table,
  "ASV_prevalence_filter_results_sample_level.tsv"
)

keep_asvs <- prevalence_counts >= 7

tss_matrix_filtered <- tss_matrix[keep_asvs, ]

cat(
  "ASVs retained after prevalence filtering:",
  nrow(tss_matrix_filtered),
  "\n"
)


# ============================================================
# 7. Add pseudocount and log2 transform
# ============================================================

log2_asv_matrix <- log2(
  tss_matrix_filtered + 1e-5
)


# ============================================================
# 8. Prepare ASV data for MaAsLin2
#
# Rows = samples
# Columns = ASVs
# ============================================================

asv_data <- as.data.frame(
  t(log2_asv_matrix)
)

asv_data$sample_name <- rownames(asv_data)

rownames(asv_data) <- NULL

asv_data <- asv_data %>%
  column_to_rownames("sample_name")


# ============================================================
# 9. Prepare metadata
# ============================================================

metadata <- metadata %>%
  filter(sample_name %in% rownames(asv_data))

metadata <- metadata[
