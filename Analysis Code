# =========================================================================
# 1. LOAD REQUIRED LIBRARIES
# =========================================================================
library(tidyverse)
library(vegan)
library(Maaslin2)
library(tidygraph)
library(ggraph)
library(igraph)

# =========================================================================
# 2. FILE PATH DEFINITIONS (Verify these files are in your active directory)
# =========================================================================
feature_table_file <- "featuretable_gg2.tsv"
metadata_all_file  <- "sm_metadata_all_groups.tsv"
taxonomy_file      <- "taxonomy_gg2.tsv"

# =========================================================================
# 3. LOAD AND FILTER RAW MICROBIOME & METADATA FILES
# =========================================================================
# Load raw sequence feature count matrix 
# check.names = FALSE keeps R from changing your hyphens into periods!
feature_table <- read_tsv(feature_table_file) %>%
  column_to_rownames("Feature_ID") %>%
  t() %>%
  as.data.frame(check.names = FALSE) 

# Load comprehensive metadata table
metadata_all <- read_tsv(metadata_all_file) %>%
  column_to_rownames("sample_name")

# Target exactly your 4 specified groups and break into clear fixed-effect factors
metadata_filtered <- metadata_all %>%
  rownames_to_column("sample_name") %>%
  filter(Group %in% c("OC", "OM", "MSM", "MSC")) %>%
  mutate(
    # Create Meat factor: OM and MSM consumed meat
    Meat_Intake = factor(if_else(Group %in% c("OM", "MSM"), "Yes", "No"), levels = c("No", "Yes")),
    # Create Metabolic Syndrome factor: MSM and MSC consumed MetS diet
    MetS_Diet = factor(if_else(Group %in% c("MSM", "MSC"), "Yes", "No"), levels = c("No", "Yes"))
  ) %>%
  column_to_rownames("sample_name")

# Intersect samples to ensure rows perfectly line up across count tables
common_samples    <- intersect(rownames(feature_table), rownames(metadata_filtered))
feature_filtered  <- feature_table[common_samples, ]
metadata_filtered <- metadata_filtered[common_samples, ]

# Parse taxonomy string hierarchy
tax_raw <- read_tsv(taxonomy_file)
tax_table <- tax_raw %>%
  separate_wider_delim(
    cols = Taxon, # Matches your actual column name 'Taxon'
    delim = ";", 
    names = c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species"),
    too_few = "align_start"
  ) %>%
  mutate(across(everything(), ~ str_trim(.x)))

# =========================================================================
# 4. RUN MAASLIN2 AT THE CORE ASV LEVEL
# =========================================================================
message("Running MaAsLin2 at baseline ASV level...")
maaslin_asv <- Maaslin2(
  input_data      = feature_filtered,
  input_metadata  = metadata_filtered,
  output          = "standalone_maaslin2_asv",
  fixed_effects   = c("Meat_Intake", "MetS_Diet"),
  normalization   = "TSS",
  transform       = "LOG",
  analysis_method = "LM",
  correction      = "BH",
  plot_heatmap    = FALSE,
  plot_scatter    = FALSE,
  min_abundance   = 0.0,
  min_prevalence  = 0.1
)

# Collect baseline Meat Intake results
all_maaslin_hits <- list()
all_maaslin_hits[["ASV"]] <- read_tsv("standalone_maaslin2_asv/all_results.tsv") %>%
  dplyr::filter(metadata == "Meat_Intake") %>%
  mutate(Rank = "ASV")

# =========================================================================
# 5. LOOP MAASLIN2 ACROSS HIGHER TAXONOMIC RANKS (Base R Matrix Style)
# =========================================================================
ranks <- c("Species", "Genus", "Family", "Order", "Class", "Phylum")

for (r in ranks) {
  message(paste("Aggregating and running MaAsLin2 for rank:", r))
  
  # Isolate mapping of ASV IDs to current rank from your parsed tax_table
  rank_mapping <- tax_table %>%
    dplyr::select(Feature_ID, Target_Rank = !!sym(r)) %>%
    dplyr::filter(!is.na(Target_Rank), Target_Rank != "", !str_detect(Target_Rank, "__$"))
  
  # Intersect to find ASVs present in both the count table and taxonomy mapping
  common_asvs <- intersect(colnames(feature_filtered), rank_mapping$Feature_ID)
  
  # Slice and filter the map and feature matrix down to matching features
  sub_map      <- rank_mapping %>% dplyr::filter(Feature_ID %in% common_asvs)
  sub_features <- as.matrix(feature_filtered[, common_asvs])
  
  # Base R split-apply matrix aggregation to bypass SummarizedExperiment crashes
  unique_ranks <- unique(sub_map$Target_Rank)
  features_with_tax_mat <- matrix(0, nrow = nrow(sub_features), ncol = length(unique_ranks),
                                  dimnames = list(rownames(sub_features), unique_ranks))
  
  for(u_rank in unique_ranks) {
    asvs_in_rank <- sub_map$Feature_ID[sub_map$Target_Rank == u_rank]
    if(length(asvs_in_rank) == 1) {
      features_with_tax_mat[, u_rank] <- sub_features[, asvs_in_rank]
    } else {
      features_with_tax_mat[, u_rank] <- rowSums(sub_features[, asvs_in_rank])
    }
  }
  
  features_with_tax <- as.data.frame(features_with_tax_mat)
  
  output_dir <- paste0("standalone_maaslin2_", tolower(r))
  
  fit_rank <- Maaslin2(
    input_data      = features_with_tax,
    input_metadata  = metadata_filtered,
    output          = output_dir,
    fixed_effects   = c("Meat_Intake", "MetS_Diet"),
    normalization   = "TSS",
    transform       = "LOG",
    analysis_method = "LM",
    correction      = "BH",
    plot_heatmap    = FALSE,
    plot_scatter    = FALSE
  )
  
  all_maaslin_hits[[r]] <- read_tsv(paste0(output_dir, "/all_results.tsv")) %>%
    dplyr::filter(metadata == "Meat_Intake") %>%
    mutate(Rank = r)
}

# Consolidate all levels, clean MaAsLin2 period-mangling, and map directions
master_sig_cleaned <- bind_rows(all_maaslin_hits) %>%
  dplyr::filter(qval < 0.05) %>%
  mutate(
    Direction = if_else(coef > 0, "Meat_Enriched", "Meat_Depleted"),
    # Fix MaAsLin2's internal period-conversion on features to ensure a perfect text match
    feature_repaired = if_else(Rank == "ASV", gsub("[.]", "-", feature), gsub("[.]", "-", feature))
  )

write_csv(master_sig_cleaned, "master_standalone_meat_sig_results.csv")


# =========================================================================
# 6. FILTER LINEAGES AND ASSEMBLE GRAPH STRUCTURE (GENUS TIPS - MEAT)
# =========================================================================
message("Building taxonomy cladogram tree structures at Genus level...")

# Isolate the significant Genus names directly from your multi-rank results table
sig_genera_meat <- master_sig_cleaned %>%
  dplyr::filter(Rank == "Genus") %>%
  pull(feature_repaired)

# Filter full hierarchy table down to rows containing these significant genera
tax_subset_genus <- tax_table %>%
  dplyr::filter(Genus %in% sig_genera_meat)

# Build nested text edges terminating strictly at Genus level (Removes Species and ASV)
edges_genus <- bind_rows(
  tax_subset_genus %>% dplyr::select(from = Kingdom, to = Phylum),
  tax_subset_genus %>% dplyr::select(from = Phylum, to = Class),
  tax_subset_genus %>% dplyr::select(from = Class, to = Order),
  tax_subset_genus %>% dplyr::select(from = Order, to = Family),
  tax_subset_genus %>% dplyr::select(from = Family, to = Genus)
) %>% 
  distinct() %>%
  dplyr::filter(!is.na(from) & !is.na(to) & from != "" & to != "")

# Compile unique node properties
