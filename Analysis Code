# 2. Function to extract pairwise differences (FDR corrected)
pairwise_permanova <- function(x, groups) {
  group_levels <- unique(as.character(groups))
  pairs <- combn(group_levels, 2)
  results <- data.frame()
  
  for(i in 1:ncol(pairs)) {
    g1 <- pairs[1, i]
    g2 <- pairs[2, i]
    
    subset_idx <- groups %in% c(g1, g2)
    sub_matrix <- as.matrix(x)[subset_idx, subset_idx]
    sub_groups <- groups[subset_idx]
    
    res <- adonis2(as.dist(sub_matrix) ~ sub_groups, permutations = 999)
    
    results <- rbind(results, data.frame(
      Comparison = paste(g1, "vs", g2),
      R2 = res$R2[1],
      p_value = res$`Pr(>F)`[1]
    ))
  }
  
  # Benjamini-Hochberg (FDR) correction for 36 comparisons
  results$p_adjusted <- p.adjust(results$p_value, method = "fdr")
  return(results)
}

# 3. Run and filter for significant differences
pairwise_results <- pairwise_permanova(dist_matrix, metadata_table$Group)

print("--- Significant Group-to-Group Differences ---")
pairwise_results %>% 
  dplyr::filter(p_adjusted < 0.05) %>% 
  print()
